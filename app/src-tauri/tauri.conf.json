{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Janus Scan",
  "version": "0.1.0",
  "identifier": "io.janusscan.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Janus Scan",
        "width": 1240,
        "height": 820,
        "minWidth": 760,
        "minHeight": 540,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Scan documents with the Brother ADS-1000W",
    "longDescription": "Scan one or both sides, many pages at a time, and save PDF, JPEG, PNG or TIFF. For the Brother ADS-1000W over USB or Wi-Fi.",
    "linux": {
      "deb": {
        "depends": [
          "libsane1"
        ]
      }
    },
    "publisher": "Janus Chung",
    "homepage": "https://github.com/januschung/janus-scan",
    "copyright": "Copyright (c) 2026 Janus Chung",
    "license": "MIT"
  }
}
